{
  "appId": "com.stockapp.viewer",
  "appName": "股票看盘",
  "webDir": "./",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1890ff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#1890ff"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_alarm",
      "iconColor": "#1890ff",
      "sound": "beep.mp3"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}